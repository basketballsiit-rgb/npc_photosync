# Database (MySQL via Prisma ORM - default XAMPP MySQL configuration)
DATABASE_URL="mysql://root:@localhost:3306/npc_photosync"

# NextAuth.js & Google Workspace Authentication (SSO)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-this-to-a-secure-random-32-byte-hex-secret"
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
ALLOWED_EMAIL_DOMAIN="pvc.ac.th"

# Google Drive API v3 (Shared Drive Service Account Credentials)
GOOGLE_SERVICE_ACCOUNT_EMAIL="npc-photosync-sa@your-gcp-project.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHARED_DRIVE_ROOT_ID="0AFqXXXXXXXXXXXXXXXXX"

# npc_smartflow Two-Way Integration API
NPC_SMARTFLOW_API_URL="https://smartflow.pvc.ac.th/api/v1"
NPC_SMARTFLOW_SECRET_KEY="secret-key-for-consuming-smartflow-projects"
PHOTOSYNC_API_KEY="photosync-secure-rest-api-key-for-smartflow-reports"

# AI Vision & LINE PR Notification
GEMINI_API_KEY="AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
LINE_CHANNEL_ACCESS_TOKEN="your-line-channel-access-token"
LINE_TARGET_GROUP_ID="C1234567890abcdef1234567890abcdef"

# Storage Settings
LOCAL_MEDIA_STORAGE_PATH="./public/uploads"
